generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: For Prisma v7+, the URL is managed in prisma.config.ts
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ✅ Dynamic post tags managed by admins
model PostTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  emoji     String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

// ✅ NEW: Added for the moderation feature
enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                     String                @id @default(cuid())
  email                  String?               @unique // Обновлено для NextAuth
  name                   String?
  emoji                  String                @default("☕")
  createdAt              DateTime              @default(now())
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?               // Оставлено для обратной совместимости старых аккаунтов
  college                String                @default("Bang College of Business")
  kimepId                Int?
  major                  String?
  status                 String?
  yearOfStudy            Int?
  username               String                @unique
  isGroupAccount         Boolean               @default(false)
  isOfficial             Boolean               @default(false)

  // === НОВЫЕ ПОЛЯ (OAuth, Легальность, Масштабирование) ===
  termsAcceptedAt        DateTime?             // Фиксация даты принятия Terms of Service / Privacy
  termsVersion           Int                   @default(1) // Версия правил (поможет, когда будешь менять условия)
  university             String                @default("KIMEP") // Фундамент для НУ, КБТУ, Кардиффа и т.д.
  role                   String                @default("USER")  // Роль для доступа ("USER" или "ADMIN" для тестов)
  // ==========================================================

  accounts               Account[]
  badges                 Badge[]
  comments               Comment[]
  conversations          ConversationMember[]
  notifications          Notification[]        @relation("UserNotifications")
  causedNotifications    Notification[]        @relation("NotificationActor")
  eventsCreated          Event[]               @relation("UserCreatedEvents")
  eventAttendance        EventAttendance[]
  eventRequests          EventRequest[]
  sentFriendRequests     FriendRequest[]       @relation("sentFriendRequests")
  receivedFriendRequests FriendRequest[]       @relation("receivedFriendRequests")
  friendshipsA           Friendship[]          @relation("friendshipA")
  friendshipsB           Friendship[]          @relation("friendshipB")
  groupsAsPresident      Group[]               @relation("groupsAsPresident")
  groupCreateRequests    GroupCreateRequest[]
  groupFollows           GroupFollow[]
  groupJoinRequests      GroupJoinRequest[]
  groupMemberships       GroupMember[]
  likes                  Like[]
  messages               Message[]
  posts                  Post[]
  professorVotes         ProfessorVote[]
  sessions               Session[]
  postReactions          PostReaction[]
  postReports            PostReport[]
  campusStatus           CampusStatus?
  campusStatusUpdatedAt  DateTime?
  campusStatusExpiresAt  DateTime?
  campusStatusVisibility CampusVisibility      @default(FRIENDS)
  campusStatusDuration   CampusDuration        @default(H2)
  friendsListVisibility  ProfileVisibility     @default(EVERYONE)
  groupsVisibility       ProfileVisibility     @default(EVERYONE)
  dmPrivacy              DmPrivacy             @default(EVERYONE)
  language               AppLanguage           @default(EN)

  @@index([username])
}

model Post {
  id            String         @id @default(cuid())
  content       String
  anonymous     Boolean        @default(true)
  
  // ✅ NEW: Defaulting to APPROVED so existing posts stay live
  status        PostStatus     @default(APPROVED)

  category      String         @default("OTHER")

  imageUrl      String?
  imageKey      String?

  authorId      String
  author        User           @relation(fields: [authorId], references: [id])

  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  comments      Comment[]
  likes         Like[]
  postReactions PostReaction[]
  reports       PostReport[]

  @@index([category, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model Comment {
  id         String     @id @default(cuid())
  content    String     @default("")
  anonymous  Boolean    @default(false)
  status     PostStatus @default(APPROVED)

  postId     String
  authorId   String
  createdAt  DateTime   @default(now())

  // GIF fields
  giphyId    String?
  giphyTitle String?

  author     User       @relation(fields: [authorId], references: [id])
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Badge {
  id     String @id @default(cuid())
  name   String
  emoji  String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime @default(now())

  imageUrl    String?
  imageKey    String?

  createdById String
  createdBy   User     @relation("UserCreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)

  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  attendees   EventAttendance[]

  @@index([groupId, startsAt])
}

model EventAttendance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventRequest {
  id            String             @id @default(cuid())
  title         String
  description   String
  location      String?
  startsAt      DateTime
  endsAt        DateTime?
  createdAt     DateTime           @default(now())
  status        EventRequestStatus @default(PENDING)
  requestedById String
  requestedBy   User               @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  imageUrl      String?
}

model Conversation {
  id        String               @id @default(cuid())
  type      ConversationType
  name      String?
  dmKey     String?              @unique
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  text           String
  conversationId String
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model FriendRequest {
  id        String              @id @default(cuid())
  createdAt DateTime            @default(now())
  status    FriendRequestStatus @default(PENDING)
  fromId    String
  toId      String
  from      User                @relation("sentFriendRequests", fields: [fromId], references: [id], onDelete: Cascade)
  to                User                @relation("receivedFriendRequests", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userAId   String
  userBId   String
  userA     User     @relation("friendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("friendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Group {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name        String
  slug        String   @unique
  description String?
  image       String?

  status      GroupStatus @default(PENDING)

  presidentId String
  president   User        @relation("groupsAsPresident", fields: [presidentId], references: [id], onDelete: Cascade)

  members      GroupMember[]
  followers    GroupFollow[]
  joinRequests GroupJoinRequest[]

  membersListVisibility MembersListVisibility @default(EVERYONE)

  events Event[]
}

model GroupMember {
  id           String    @id @default(cuid())
  joinedAt     DateTime  @default(now())
  role         GroupRole @default(MEMBER)
  groupId      String
  userId       String
  position     String?
  showPosition Boolean   @default(false)
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupFollow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  groupId   String
  userId    String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupJoinRequest {
  id        String                 @id @default(cuid())
  createdAt DateTime               @default(now())
  status    GroupJoinRequestStatus @default(PENDING)
  groupId   String
  userId    String
  message   String?
  group     Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model GroupCreateRequest {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  name          String
  slug          String      @unique
  description   String?
  image         String?
  requestedById String
  status        GroupStatus @default(PENDING)
  adminNote     String?
  requestedBy   User        @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([status])
}

model Professor {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  name      String          @unique
  votes     ProfessorVote[]
}

model ProfessorVote {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String
  professorId String
  value       Int
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, professorId])
  @@index([professorId])
}

enum EventRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupRole {
  PRESIDENT
  ADMIN
  MEMBER
}

enum GroupJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostReactionType {
  LAUGH
  SKULL
}

model PostReaction {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  type      PostReactionType

  postId    String
  userId    String

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model PostReport {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

enum CampusStatus {
  ON
  OFF
}

enum CampusVisibility {
  ONLY_ME
  FRIENDS
  EVERYONE
}

enum CampusDuration {
  H2
  H4
  EOD
}

enum ProfileVisibility {
  EVERYONE
  FRIENDS_ONLY
}

enum DmPrivacy {
  EVERYONE
  FRIENDS_ONLY
}

enum MembersListVisibility {
  EVERYONE
  MEMBERS_ONLY
}

enum AppLanguage {
  EN
  RU
  KK
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  POST_REPLY
  POST_REACTION
  EVENT_JOINED
  EVENT_APPROVED
  EVENT_REJECTED
  GROUP_JOIN_APPROVED
  GROUP_JOIN_REJECTED
  GROUP_CREATE_APPROVED
  GROUP_CREATE_REJECTED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)

  title     String
  body      String?
  href      String?
  isRead    Boolean          @default(false)

  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}